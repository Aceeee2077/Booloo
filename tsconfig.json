{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2020", "DOM"],
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "sourceMap": false
  },
  "include": [
    "src/renderer/lite-*.ts",
    "src/renderer/anim-types.ts",
    "src/shared/types.ts",
    "src/shared/accessory-types.ts",
    "src/shared/petpack-types.ts",
    "src/shared/i18n.ts"
  ]
}
